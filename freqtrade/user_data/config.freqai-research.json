{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 25,
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 250,
  "cancel_open_orders_on_exit": false,
  "timeframe": "15m",
  "trading_mode": "spot",
  "minimal_roi": {
    "0": 0.04
  },
  "stoploss": -0.02,
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false,
    "force_entry": "market"
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "exchange": {
    "name": "bitget",
    "api_key": "",
    "secret": "",
    "password": "",
    "pair_whitelist": [
      "BTC/USDT"
    ],
    "pair_blacklist": []
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": "",
    "allow_custom_messages": false
  },
  "api_server": {
    "enabled": false
  },
  "db_url": "sqlite:///user_data/tradesv3.freqai-research.dryrun.sqlite",
  "initial_state": "stopped",
  "force_entry_enable": false,
  "strategy": "LowCostFreqAI",
  "strategy_path": "user_data/strategies/",
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "unfilledtimeout": {
    "entry": 2,
    "exit": 2,
    "unit": "minutes"
  },
  "ignore_buying_expired_candle_after": 120,
  "freqaimodel": "LightGBMClassifier",
  "freqai": {
    "enabled": true,
    "identifier": "low-cost-lightgbm-v1",
    "train_period_days": 180,
    "backtest_period_days": 30,
    "live_retrain_hours": 24,
    "expiration_hours": 30,
    "purge_old_models": 2,
    "continual_learning": false,
    "data_kitchen_thread_count": 2,
    "activate_tensorboard": false,
    "write_metrics_to_disk": true,
    "feature_parameters": {
      "include_timeframes": [
        "15m",
        "1h"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 8,
      "include_shifted_candles": 1,
      "indicator_periods_candles": [
        14
      ],
      "buffer_train_data_candles": 8,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 100,
      "num_leaves": 15,
      "max_depth": 4,
      "learning_rate": 0.05,
      "n_jobs": 2,
      "verbosity": -1,
      "random_state": 42
    }
  }
}
