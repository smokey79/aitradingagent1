{
  "name": "aitradingagent",
  "version": "1.0.0",
  "description": "Local trading research with separate Freqtrade dry-run execution",
  "main": "orchestrator/index.js",
  "scripts": {
    "start": "node orchestrator/index.js",
    "research": "node orchestrator/index.js",
    "paper": "docker compose -f freqtrade/compose.yaml up -d",
    "paper:stop": "docker compose -f freqtrade/compose.yaml stop",
    "paper:status": "docker compose -f freqtrade/compose.yaml ps",
    "check": "node scripts/check-config.js",
    "setup": "node scripts/check-config.js",
    "test": "node --test",
    "dashboard": "node dashboard/server.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ccxt": "^4.2.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "googleapis": "^128.0.0",
    "node-cron": "^3.0.3",
    "ws": "^8.16.0",
    "youtube-transcript": "^1.2.1",
    "winston": "^3.11.0",
    "technicalindicators": "^3.1.0",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
