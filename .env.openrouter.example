# ═══════════════════════════════════════════════════════════════════════════
# AI TRADING AGENT — OPENROUTER + HERMES OPTIMIZED CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Copy this to .env and fill in your keys. Uses ONLY free OpenRouter + local Hermes.
# Cost: $0/month (free tier credits). Hardware: 16GB RAM, Radeon 5000 optimized.

# ═══════════════════════════════════════════════════════════════════════════
# API KEYS (Get from links below)
# ═══════════════════════════════════════════════════════════════════════════

# OpenRouter (free tier, $5-10/month credits included)
# Get yours: https://openrouter.ai → create API key
OPENROUTER_API_KEY=sk-or-xxxxx

# Local Hermes (via Ollama, no API key needed)
# Install: https://ollama.ai → ollama pull hermes3
HERMES_MODEL=hermes3
OLLAMA_URL=http://localhost:11434/api/generate

# YouTube API (for sentiment analysis, free)
# Optional but recommended for contrarian signals
YOUTUBE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# TRADING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Trading pairs (comma-separated, must exist on your exchange)
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT

# Paper trading mode (set to false ONLY for live trading!)
# ALWAYS test with true first!
PAPER_TRADING=true

# Run cycle every N minutes (cron format)
# */15 = every 15 minutes (recommended)
# */5 = every 5 minutes (aggressive)
# 0 * = every hour (slow)
CYCLE_INTERVAL=*/15 * * * *

# Minimum confidence threshold before executing trade (0.0-1.0)
# 0.70 = 70% consensus confidence required
# Higher = more conservative, fewer trades
# Lower = more aggressive, higher risk
MIN_CONFIDENCE=0.70

# ═══════════════════════════════════════════════════════════════════════════
# RISK MANAGEMENT (Hard rules — NEVER skip these)
# ═══════════════════════════════════════════════════════════════════════════

# Initial account balance (USD)
# Used for position sizing and leverage calculations
INITIAL_DEPOSIT=250

# Maximum leverage allowed (1-5)
# 1 = no leverage (safest)
# 3 = 3x leverage (medium)
# 5 = 5x leverage (aggressive, use with caution)
LEVERAGE_MAX=5

# ═══════════════════════════════════════════════════════════════════════════
# EXCHANGE CREDENTIALS (Bitget + Crypto.com)
# ═══════════════════════════════════════════════════════════════════════════

# Bitget (primary exchange, supports leverage)
# Get from: https://www.bitget.com/account/apiManage
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Crypto.com (backup exchange, lower leverage)
# Get from: https://crypto.com/exchange/user/account/api
CRYPTO_COM_API_KEY=
CRYPTO_COM_API_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
# LOGGING & DEBUG
# ═══════════════════════════════════════════════════════════════════════════

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Save logs to file? (true/false)
LOG_FILE=true

# Dashboard port (optional: http://localhost:3000)
DASHBOARD_PORT=3000

# ═══════════════════════════════════════════════════════════════════════════
# ADVANCED (Tweak only if you know what you're doing)
# ═══════════════════════════════════════════════════════════════════════════

# Market data cache (seconds)
DATA_CACHE_TTL=60

# On-chain data source
ONCHAIN_SOURCE=glassnode

# Sentiment weights (if YouTube sentiment disabled, set to 0)
SENTIMENT_WEIGHT=0.25

# ═══════════════════════════════════════════════════════════════════════════
# SETUP CHECKLIST
# ═══════════════════════════════════════════════════════════════════════════
#
# [ ] 1. Get OpenRouter API key: https://openrouter.ai
# [ ] 2. Install Ollama: https://ollama.ai
# [ ] 3. Pull Hermes model: ollama pull hermes3
# [ ] 4. Fill in OPENROUTER_API_KEY below
# [ ] 5. Test with PAPER_TRADING=true first!
# [ ] 6. Run: npm start (paper mode)
# [ ] 7. Watch logs, verify signals make sense
# [ ] 8. Only then: set PAPER_TRADING=false (live)
#
# ═══════════════════════════════════════════════════════════════════════════
