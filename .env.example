# Copy to .env and fill in. .env is git-ignored.
OLLAMA_URL=http://localhost:11434/api/generate
HERMES_MODEL=hermes3

# --- Community sentiment (agents/community/communityAgent.js) ---
# Subreddits to read (new posts + latest comments). No key needed.
REDDIT_SUBS=CryptoCurrency,CryptoMarkets,Bitcoin,ethtrader,solana
# Extra RSS/Atom feeds: name|url,name|url   ({symbol} is replaced with BTC, ETH...)
# TradingView ideas feed (verify it opens in your browser first):
#   tradingview|https://www.tradingview.com/feed/?sort=recent&symbol=BINANCE:{symbol}USDT
# Trading212 community: open a board on community.trading212.com, look for its RSS link, then add:
#   t212|<that rss url>
COMMUNITY_FEEDS=
